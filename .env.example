# Names only. Configure real values in your hosting provider's secret settings.
# Never commit a populated .env file. Only VITE_* values are bundled into browsers.
NODE_ENV=production
PORT=10000
ENABLE_REPLIT_AUTH=false
RUN_BACKGROUND_JOBS=true
DATABASE_URL=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ADMIN_EMAILS=
APP_URL=

# AI summaries: use the SAME encryption secret used by existing encrypted keys.
# When AI_SECRET_ENCRYPTION_KEY was absent, encryption used SESSION_SECRET.
OPENAI_API_KEY=
AI_SECRET_ENCRYPTION_KEY=

# Gmail App Password transport (blocked on Render Free web services).
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=
SUPABASE_SEND_EMAIL_HOOK_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_DAILY_LIMIT=90
EMAIL_MONTHLY_LIMIT=2900

# Optional configured news providers.
CURRENTSAPI_KEY=
NEWSAPI_ORG_KEY=
NEWSDATA_IO_KEY=
MEDIASTACK_KEY=

# Optional legacy Replit OIDC, disabled on Render.
# REPL_ID=
# ISSUER_URL=
# SESSION_COOKIE_SECURE=true
